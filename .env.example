# Copy this file to .env.local and fill in the values.
# Every variable except NEXT_PUBLIC_APP_URL is server-only and must never be
# exposed to the browser.

# --- Supabase Postgres -------------------------------------------------------
# Two connection strings, NOT interchangeable. Both from the Supabase dashboard:
#   Connect -> ORM -> Drizzle
#
# Transaction pooler, port 6543. Used by the app at runtime. Serverless
# functions must use this or they exhaust connections. Transaction mode forbids
# prepared statements, which is why the client sets { prepare: false }.
DATABASE_URL=
# Session pooler, port 5432. Used ONLY by drizzle-kit. Schema DDL such as
# CREATE EXTENSION and CREATE INDEX needs a real session and fails through the
# transaction pooler. Not required in production.
DIRECT_URL=
#
# Note: do not use Supabase's "Direct connection" — it is IPv6-only without the
# paid IPv4 add-on. Also URL-encode special characters in your password
# (# -> %23, & -> %26, ? -> %3F, % -> %25) or the connection string will break.

# --- Supabase Storage --------------------------------------------------------
# Settings -> Data API -> Project URL
SUPABASE_URL=
# Settings -> API Keys -> service_role (the SECRET key, not anon).
# Required because this app enforces access control in application code rather
# than with RLS. Never send this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------------
# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# --- Auth --------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Email (optional) --------------------------------------------------------
# https://resend.com -> API Keys. Sharing works without this; only the
# notification email is skipped.
RESEND_API_KEY=

# --- App ---------------------------------------------------------------------
# Must be the deployed origin in production, or emailed share links will point
# at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
